# Public URL of this app. The OSM redirect URI is derived from it:
#   ${APP_URL}/api/auth/osm/callback
APP_URL=http://127.0.0.1:3000

# Claude API key (https://platform.claude.com). Drives the visual analysis and deep-search investigator.
ANTHROPIC_API_KEY=
# Optional model override.
# ANTHROPIC_MODEL=claude-opus-5

# ---- Region model (GeoCLIP) -------------------------------------------------
# Files come from `npm run models:download` (~350 MB, plus a ~200 MB cache built on first run).
# MODELS_DIR=models
# GEOCLIP=on                  # set to "off" to skip the region model
# GEOCLIP_PRECISION=quantized # or "fp32" (1.2 GB download, marginally more accurate)

# ---- Deep-search tools --------------------------------------------------------
# WEB_SEARCH=on               # Claude's web search tool; must be enabled for your org in the Claude Console
# Free client token from https://www.mapillary.com/dashboard/developers enables street-level imagery.
MAPILLARY_TOKEN=
# Point these at your own instances for heavy use.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# ---- Sign in with OpenStreetMap -------------------------------------------------
# OAuth 2 application (https://www.openstreetmap.org/oauth2/applications). Only "read_prefs" is needed.
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
# OSM_BASE_URL=https://www.openstreetmap.org
# OSM_API_URL=https://api.openstreetmap.org

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Daily search quota (resets 00:00 UTC). Deep search requires sign-in when OSM sign-in is configured.
FREE_SEARCHES_PER_DAY=1
USER_SEARCHES_PER_DAY=5

# Where search records, thumbnails, evidence images and quota counters are stored.
DATA_DIR=.data
