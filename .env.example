# Public URL of this app. The OSM redirect URI is derived from it:
#   ${APP_URL}/api/auth/osm/callback
APP_URL=http://127.0.0.1:3000

# Claude API key (https://platform.claude.com). Used to analyze photos.
ANTHROPIC_API_KEY=
# Optional model override.
# ANTHROPIC_MODEL=claude-opus-5

# OpenStreetMap OAuth 2 application (https://www.openstreetmap.org/oauth2/applications).
# Only the "Read user preferences (read_prefs)" permission is needed.
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
# Point these at https://master.apis.dev.openstreetmap.org to test against the OSM dev server.
# OSM_BASE_URL=https://www.openstreetmap.org
# OSM_API_URL=https://api.openstreetmap.org

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Daily search quota (resets 00:00 UTC).
FREE_SEARCHES_PER_DAY=1
USER_SEARCHES_PER_DAY=5

# Where search records, thumbnails and quota counters are stored.
DATA_DIR=.data
